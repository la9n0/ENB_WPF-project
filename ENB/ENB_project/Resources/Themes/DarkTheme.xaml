<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#0D0D0D</Color>
    <Color x:Key="SidebarBackgroundColor">#111111</Color>
    <Color x:Key="SurfaceColor">#1A1A1A</Color>
    <Color x:Key="SurfaceElevatedColor">#1E1E1E</Color>
    <Color x:Key="SurfaceHighColor">#252525</Color>
    <Color x:Key="BorderColor">#1E1E1E</Color>
    <Color x:Key="BorderSubtleColor">#1A1A1A</Color>
    <Color x:Key="BorderMutedColor">#2A2A2A</Color>
    <Color x:Key="BorderStrongColor">#333333</Color>

    <Color x:Key="AccentColor">#7C6FCD</Color>
    <Color x:Key="AccentSurfaceColor">#1A1730</Color>
    <Color x:Key="AccentDeepColor">#1E1A40</Color>

    <Color x:Key="ForegroundPrimaryColor">#CCCCCC</Color>
    <Color x:Key="ForegroundSecondaryColor">#BBBBBB</Color>
    <Color x:Key="ForegroundMutedColor">#999999</Color>
    <Color x:Key="ForegroundDimColor">#888888</Color>
    <Color x:Key="ForegroundFaintColor">#777777</Color>
    <Color x:Key="ForegroundSubtleColor">#666666</Color>
    <Color x:Key="ForegroundGhostColor">#555555</Color>
    <Color x:Key="ForegroundDeepColor">#444444</Color>
    <Color x:Key="ForegroundPhantomColor">#1C1C1C</Color>

    <Color x:Key="ScrollThumbColor">#2E2E2E</Color>
    <Color x:Key="ScrollThumbHoverColor">#444444</Color>

    <Color x:Key="DragHighlightColor">#1E1A40</Color>
    <Color x:Key="DragHighlightBorderColor">#7C6FCD</Color>

    <Color x:Key="ErrorColor">#CC4444</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush"      Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush"     Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"               Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush"       Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="SurfaceHighBrush"           Color="{StaticResource SurfaceHighColor}"/>
    <SolidColorBrush x:Key="BorderBrush"                Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"          Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderMutedBrush"           Color="{StaticResource BorderMutedColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush"          Color="{StaticResource BorderStrongColor}"/>

    <SolidColorBrush x:Key="AccentBrush"                Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSurfaceBrush"         Color="{StaticResource AccentSurfaceColor}"/>
    <SolidColorBrush x:Key="AccentDeepBrush"            Color="{StaticResource AccentDeepColor}"/>

    <SolidColorBrush x:Key="ForegroundPrimaryBrush"     Color="{StaticResource ForegroundPrimaryColor}"/>
    <SolidColorBrush x:Key="ForegroundSecondaryBrush"   Color="{StaticResource ForegroundSecondaryColor}"/>
    <SolidColorBrush x:Key="ForegroundMutedBrush"       Color="{StaticResource ForegroundMutedColor}"/>
    <SolidColorBrush x:Key="ForegroundDimBrush"         Color="{StaticResource ForegroundDimColor}"/>
    <SolidColorBrush x:Key="ForegroundFaintBrush"       Color="{StaticResource ForegroundFaintColor}"/>
    <SolidColorBrush x:Key="ForegroundSubtleBrush"      Color="{StaticResource ForegroundSubtleColor}"/>
    <SolidColorBrush x:Key="ForegroundGhostBrush"       Color="{StaticResource ForegroundGhostColor}"/>
    <SolidColorBrush x:Key="ForegroundDeepBrush"        Color="{StaticResource ForegroundDeepColor}"/>
    <SolidColorBrush x:Key="ForegroundPhantomBrush"     Color="{StaticResource ForegroundPhantomColor}"/>

    <SolidColorBrush x:Key="ScrollThumbBrush"           Color="{StaticResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush"      Color="{StaticResource ScrollThumbHoverColor}"/>

    <SolidColorBrush x:Key="DragHighlightBrush"         Color="{StaticResource DragHighlightColor}"/>
    <SolidColorBrush x:Key="DragHighlightBorderBrush"   Color="{StaticResource DragHighlightBorderColor}"/>

    <SolidColorBrush x:Key="ErrorBrush"                 Color="{StaticResource ErrorColor}"/>

</ResourceDictionary>
