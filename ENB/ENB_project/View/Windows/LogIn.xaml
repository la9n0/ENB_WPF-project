<Window x:Class="ENB_project.LogIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls1="clr-namespace:ENB_project.Controls"
        Title="ENB" Height="330" Width="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
    </Window.Effect>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center">

                <TextBlock Text="ENB"
                           Foreground="{DynamicResource ForegroundPhantomBrush}"
                           FontFamily="Segoe UI"
                           FontSize="36"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <TextBlock Text="{DynamicResource LogInLoginLabel}"
                           Foreground="{DynamicResource ForegroundSubtleBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,10">
                    <TextBox x:Name="LoginBox"
                             Background="Transparent"
                             Foreground="{DynamicResource ForegroundPrimaryBrush}"
                             CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             BorderThickness="0"
                             FontFamily="Segoe UI"
                             FontSize="13"
                             Padding="8,6"/>
                </Border>

                <TextBlock Text="{DynamicResource LogInPasswordLabel}"
                           Foreground="{DynamicResource ForegroundSubtleBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,10">
                    <PasswordBox x:Name="PasswordBox"
                                 Background="Transparent"
                                 Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                 CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 BorderThickness="0"
                                 FontFamily="Segoe UI"
                                 FontSize="13"
                                 Padding="8,6"/>
                </Border>

                <Border Background="{DynamicResource AccentBrush}"
                        CornerRadius="4"
                        Margin="0,4,0,0"
                        Cursor="Hand">
                    <Button Content="{DynamicResource LogInLoginButton}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Height="32"
                            Cursor="Hand"
                            Click="Login_Click"/>
                </Border>

                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           TextAlignment="Center"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="{DynamicResource LogInRegistration}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource AccentBrush}"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        Click="RegistrationButton_click"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource LanguageLabel}"
                               Foreground="{DynamicResource ForegroundSubtleBrush}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <controls1:DropList x:Name="LanguageDrop"
                                       Width="100"
                                       SelectionChanged="LanguageCombo_SelectionChanged"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>