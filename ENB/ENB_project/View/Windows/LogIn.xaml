<Window x:Class="ENB_project.LogIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ENB" SizeToContent="Height" Width="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="DropComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                                <TextBlock x:Name="Arrow"
                                           Grid.Column="1"
                                           Text="›"
                                           FontSize="14"
                                           Foreground="{DynamicResource ForegroundGhostBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="ArrowRotate" Angle="90"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background"  Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ForegroundGhostBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background"  Value="{DynamicResource AccentDeepBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="270" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="90" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="DropComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton Style="{StaticResource DropComboBoxToggleButton}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}"
                              Height="{TemplateBinding Height}">
                    <TextBlock Text="{TemplateBinding Text}"
                               Foreground="{DynamicResource ForegroundPrimaryBrush}"
                               FontFamily="Segoe UI"
                               FontSize="12.5"
                               VerticalAlignment="Center"/>
                </ToggleButton>
                <Popup IsOpen="{Binding IsDropDownOpen,
                               RelativeSource={RelativeSource TemplatedParent}}"
                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Bottom"
                       StaysOpen="False"
                       MinWidth="{Binding ActualWidth,
                                  RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,2,0,0">
                        <ItemsPresenter/>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="DropComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground"  Value="{DynamicResource ForegroundMutedBrush}"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Padding"     Value="10,6"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="12.5"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource SurfaceHighBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ForegroundPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource AccentDeepBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DropComboBox" TargetType="ComboBox">
            <Setter Property="Template"           Value="{StaticResource DropComboBoxTemplate}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DropComboBoxItemStyle}"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="IsEditable"         Value="False"/>
        </Style>

    </Window.Resources>

    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
    </Window.Effect>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            CornerRadius="8"
            ClipToBounds="True"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center">

                <TextBlock Text="ENB"
                           Foreground="{DynamicResource ForegroundPhantomBrush}"
                           FontFamily="Segoe UI"
                           FontSize="36"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <TextBlock Text="{DynamicResource LogInLoginLabel}"
                           Foreground="{DynamicResource ForegroundSubtleBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,10">
                    <TextBox x:Name="LoginBox"
                             Background="Transparent"
                             Foreground="{DynamicResource ForegroundPrimaryBrush}"
                             CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             BorderThickness="0"
                             FontFamily="Segoe UI"
                             FontSize="13"
                             Padding="8,6"
                             TextChanged="UsernameSizeControl"/>
                </Border>

                <TextBlock x:Name="LoginError"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           TextAlignment="Center"
                           Margin="0,-10,0,0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{DynamicResource LogInPasswordLabel}"
                           Foreground="{DynamicResource ForegroundSubtleBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,10">
                    <PasswordBox x:Name="PasswordBox"
                                 Background="Transparent"
                                 Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                 CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 BorderThickness="0"
                                 FontFamily="Segoe UI"
                                 FontSize="13"
                                 Padding="8,6"
                                 PasswordChanged="PasswordSizeControl"/>
                </Border>

                <TextBlock x:Name="PasswordError"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           TextAlignment="Center"
                           Margin="0,-10,0,10"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>

                <Border Background="{DynamicResource AccentBrush}"
                        CornerRadius="4"
                        Margin="0,4,0,0"
                        Cursor="Hand">
                    <Button Content="{DynamicResource LogInLoginButton}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Height="32"
                            Cursor="Hand"
                            Click="Login_Click"/>
                </Border>

                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           TextAlignment="Center"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="{DynamicResource LogInRegistration}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource AccentBrush}"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Margin="0,15,0,0"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        Click="RegistrationButton_click"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource LanguageLabel}"
                               Foreground="{DynamicResource ForegroundSubtleBrush}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,20,6,0"/>
                    <ComboBox x:Name="LanguageDrop"
                              Style="{StaticResource DropComboBox}"
                              Width="100"
                              Height="30"
                              Margin="0,10,0,0"
                              SelectionChanged="LanguageCombo_SelectionChanged"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>