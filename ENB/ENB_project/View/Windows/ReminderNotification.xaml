<Window x:Class="ENB_project.ReminderNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
    </Window.Effect>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="#E5C07B"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <StackPanel Margin="16">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="🔔"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{DynamicResource ReminderNotifTitle}"
                           Foreground="#E5C07B"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="NoteNameText"
                       Foreground="{DynamicResource ForegroundPrimaryBrush}"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"/>

            <TextBlock x:Name="NoteText"
                       Foreground="{DynamicResource ForegroundGhostBrush}"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="TimeText"
                       Foreground="{DynamicResource ForegroundGhostBrush}"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Margin="0,0,0,14"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="4" Cursor="Hand">
                    <Button Content="{DynamicResource ReminderNotifOpen}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontFamily="Segoe UI" FontSize="12"
                            Height="28" Cursor="Hand"
                            Click="Open_Click"/>
                </Border>

                <Button Grid.Column="2"
                        Content="{DynamicResource ReminderNotifClose}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource ForegroundMutedBrush}"
                        FontFamily="Segoe UI" FontSize="12"
                        Height="28" Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>