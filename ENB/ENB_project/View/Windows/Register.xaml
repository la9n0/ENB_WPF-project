<Window x:Class="ENB_project.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ENB" SizeToContent="Height" Width="340"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="DropComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                                <TextBlock x:Name="Arrow"
                                           Grid.Column="1"
                                           Text="›"
                                           FontSize="14"
                                           Foreground="{DynamicResource ForegroundGhostBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="ArrowRotate" Angle="90"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background"  Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ForegroundGhostBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background"  Value="{DynamicResource AccentDeepBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="270" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="90" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="DropComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton Style="{StaticResource DropComboBoxToggleButton}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}"
                              Height="{TemplateBinding Height}">
                    <TextBlock Text="{TemplateBinding Text}"
                               Foreground="{DynamicResource ForegroundPrimaryBrush}"
                               FontFamily="Segoe UI"
                               FontSize="12.5"
                               VerticalAlignment="Center"/>
                </ToggleButton>
                <Popup IsOpen="{Binding IsDropDownOpen,
                               RelativeSource={RelativeSource TemplatedParent}}"
                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Bottom"
                       StaysOpen="False"
                       MinWidth="{Binding ActualWidth,
                                  RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,2,0,0">
                        <ItemsPresenter/>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="DropComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground"  Value="{DynamicResource ForegroundMutedBrush}"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Padding"     Value="10,6"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="12.5"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource SurfaceHighBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ForegroundPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource AccentDeepBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DropComboBox" TargetType="ComboBox">
            <Setter Property="Template"           Value="{StaticResource DropComboBoxTemplate}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DropComboBoxItemStyle}"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="IsEditable"         Value="False"/>
        </Style>

    </Window.Resources>

    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
    </Window.Effect>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="{DynamicResource RegisterNewUser}"
                           Foreground="{DynamicResource ForegroundPrimaryBrush}"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="{DynamicResource RegisterLogin}"
                           Foreground="{DynamicResource ForegroundSubtleBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Margin="0,0,0,12">
                    <TextBox x:Name="UsernameBox"
                             Background="Transparent"
                             Foreground="{DynamicResource ForegroundPrimaryBrush}"
                             CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             BorderThickness="0"
                             FontFamily="Segoe UI" FontSize="13"
                             Padding="8,6"
                             TextChanged="UsernameSizeControl"/>
                </Border>
                
                <TextBlock x:Name="LoginError"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           TextAlignment="Center"
                           Margin="0,-10,0,0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{DynamicResource RegisterPassword}"
                           Foreground="{DynamicResource ForegroundSubtleBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Margin="0,0,0,12">
                    <PasswordBox x:Name="PasswordBox1"
                                 Background="Transparent"
                                 Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                 CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                                 BorderThickness="0"
                                 FontFamily="Segoe UI" FontSize="13"
                                 Padding="8,6"
                                 LostFocus="IsPasswordsMatch"
                                 PasswordChanged="PasswordSizeControl"/>
                </Border>
                
                <TextBlock x:Name="PasswordError"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           TextAlignment="Center"
                           Margin="0,-10,0,10"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{DynamicResource RegisterRepeatPassword}"
                           Foreground="{DynamicResource ForegroundSubtleBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Margin="0,0,0,4">
                    <PasswordBox x:Name="PasswordBox2"
                                 Background="Transparent"
                                 Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                 CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                                 BorderThickness="0"
                                 FontFamily="Segoe UI" FontSize="13"
                                 Padding="8,6"
                                 PasswordChanged="IsPasswordsMatch"/>
                </Border>
                <TextBlock x:Name="PasswordsError"
                           Text="{DynamicResource RegisterPasswordsDontMatch}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           Margin="0,0,0,10"
                           Visibility="Collapsed"/>

                <TextBlock Text="Email"
                           Foreground="{DynamicResource ForegroundSubtleBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Margin="0,0,0,4">
                    <TextBox x:Name="EmailBox"
                             Background="Transparent"
                             Foreground="{DynamicResource ForegroundPrimaryBrush}"
                             CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             BorderThickness="0"
                             FontFamily="Segoe UI" FontSize="13"
                             Padding="8,6"
                             PreviewTextInput="OnlyText"
                             TextChanged="EmailCheck"/>
                </Border>
                <TextBlock x:Name="EmailError"
                           Text="{DynamicResource RegisterEmailError}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           Margin="0,0,0,5"
                           Visibility="Collapsed"/>

                <TextBlock Text="{DynamicResource LanguageLabel}"
                           Foreground="{DynamicResource ForegroundSubtleBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,6,4"/>
                <ComboBox x:Name="LanguageDrop"
                          Style="{StaticResource DropComboBox}"
                          Width="290"
                          Height="30"
                          Margin="0,0,0,20"
                          HorizontalAlignment="Left"
                          SelectionChanged="LanguageCombo_SelectionChanged"/>

                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           TextAlignment="Center"
                           Margin="0,-15,0,10"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>
            </StackPanel>
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="{DynamicResource RegisterCancel}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource ForegroundMutedBrush}"
                        FontFamily="Segoe UI" FontSize="13"
                        Height="32"
                        Cursor="Hand"
                        Click="CancelButton_Click"/>

                <Border Grid.Column="2"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="4"
                        Cursor="Hand">
                    <Button Content="{DynamicResource RegisterCreate}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontFamily="Segoe UI" FontSize="13"
                            Height="32"
                            Cursor="Hand"
                            Click="CreateButton_click"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>