<Window x:Class="ENB_project.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ENB_project.Controls"
        Title="ENB" Height="480" Width="340"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
    </Window.Effect>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="{DynamicResource RegisterNewUser}"
                           Foreground="{DynamicResource ForegroundPrimaryBrush}"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="{DynamicResource RegisterLogin}"
                           Foreground="{DynamicResource ForegroundSubtleBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Margin="0,0,0,12">
                    <TextBox x:Name="UsernameBox"
                             Background="Transparent"
                             Foreground="{DynamicResource ForegroundPrimaryBrush}"
                             CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             BorderThickness="0"
                             FontFamily="Segoe UI" FontSize="13"
                             Padding="8,6"/>
                </Border>

                <TextBlock Text="{DynamicResource RegisterPassword}"
                           Foreground="{DynamicResource ForegroundSubtleBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Margin="0,0,0,12">
                    <PasswordBox x:Name="PasswordBox1"
                                 Background="Transparent"
                                 Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                 CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                                 BorderThickness="0"
                                 FontFamily="Segoe UI" FontSize="13"
                                 Padding="8,6"
                                 LostFocus="IsPasswordsMatch"/>
                </Border>

                <TextBlock Text="{DynamicResource RegisterRepeatPassword}"
                           Foreground="{DynamicResource ForegroundSubtleBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Margin="0,0,0,4">
                    <PasswordBox x:Name="PasswordBox2"
                                 Background="Transparent"
                                 Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                 CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                                 BorderThickness="0"
                                 FontFamily="Segoe UI" FontSize="13"
                                 Padding="8,6"
                                 LostFocus="IsPasswordsMatch"/>
                </Border>
                <TextBlock x:Name="PasswordsError"
                           Text="{DynamicResource RegisterPasswordsDontMatch}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           Margin="0,0,0,10"
                           Visibility="Hidden"/>

                <TextBlock Text="Email"
                           Foreground="{DynamicResource ForegroundSubtleBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Margin="0,0,0,4">
                    <TextBox x:Name="EmailBox"
                             Background="Transparent"
                             Foreground="{DynamicResource ForegroundPrimaryBrush}"
                             CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             BorderThickness="0"
                             FontFamily="Segoe UI" FontSize="13"
                             Padding="8,6"
                             PreviewTextInput="OnlyText"
                             LostFocus="EmailCheck"/>
                </Border>
                <TextBlock x:Name="EmailError"
                           Text="{DynamicResource RegisterEmailError}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           Margin="0,0,0,12"
                           Visibility="Hidden"/>
                
                    <TextBlock Text="{DynamicResource LanguageLabel}"
                               Foreground="{DynamicResource ForegroundSubtleBrush}"
                               FontFamily="Segoe UI" FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <controls:DropList x:Name="LanguageDrop"
                                       Width="290"
                                       SelectionChanged="LanguageCombo_SelectionChanged"/>

            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{DynamicResource RegisterCancel}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderMutedBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource ForegroundMutedBrush}"
                            FontFamily="Segoe UI" FontSize="13"
                            Height="32"
                            Cursor="Hand"
                            Click="CancelButton_Click"/>

                    <Border Grid.Column="2"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="4"
                            Cursor="Hand">
                        <Button Content="{DynamicResource RegisterCreate}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontFamily="Segoe UI" FontSize="13"
                                Height="32"
                                Cursor="Hand"
                                Click="CreateButton_click"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
