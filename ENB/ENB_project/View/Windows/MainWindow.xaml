<Window x:Class="ENB_project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls1="clr-namespace:ENB_project.Controls"
        Title="notes"
        Height="800" Width="1200"
        MinHeight="500" MinWidth="700"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundDimBrush}"/>
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditSaveButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundDimBrush}"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="{DynamicResource AccentSurfaceBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"  Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        

        <Style x:Key="NewTabButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundGhostBrush}"/>
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontSize"        Value="18"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NewTabActionButton" TargetType="Button">
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Foreground"          Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontFamily"          Value="Segoe UI"/>
            <Setter Property="FontSize"            Value="14"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding"             Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
    </Window.Effect>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource WindowBackgroundBrush}" Height="40"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="8,0,0,0" Width="200">
                    <Button Style="{DynamicResource IconButton}"
                            ToolTip="{DynamicResource MainTooltipFolders}"
                            Click="FoldersButton_Click">
                        <TextBlock Text="🗂" FontSize="13"/>
                    </Button>
                    <Button Style="{DynamicResource IconButton}"
                            ToolTip="{DynamicResource MainTooltipSearch}"
                            Click="SearchButton_Click">
                        <TextBlock Text="🔍" FontSize="12"/>
                    </Button>
                    <Button Style="{DynamicResource IconButton}"
                            ToolTip="{DynamicResource MainTooltipProfile}"
                            Click="ProfileButton_Click">
                        <TextBlock Text="👤" FontSize="12"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Stretch" HorizontalAlignment="Left">

                    <ItemsControl x:Name="TabStrip" VerticalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabBorder"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1,0,1,0"
                                        Padding="14,0,6,0"
                                        MinWidth="130" MaxWidth="200"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="Tab_MouseLeftButtonDown">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TabTitle"
                                                   Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   Foreground="{DynamicResource ForegroundFaintBrush}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                Style="{DynamicResource IconButton}"
                                                Width="20" Height="20"
                                                Margin="4,0,0,0"
                                                Tag="{Binding}"
                                                Click="TabClose_Click">
                                            <TextBlock Text="✕" FontSize="10"
                                                       Foreground="{DynamicResource ForegroundGhostBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background"
                                                Value="{DynamicResource SurfaceElevatedBrush}"/>
                                        <Setter TargetName="TabTitle" Property="Foreground"
                                                Value="{DynamicResource ForegroundPrimaryBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{DynamicResource NewTabButton}"
                            Margin="4,0,0,0" VerticalAlignment="Center"
                            ToolTip="{DynamicResource MainTooltipNewTab}"
                            Click="NewTab_Click">
                        <TextBlock Text="+" FontSize="18" Margin="0,-2,0,0"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Margin="0,0,8,0">
                    <Button Style="{DynamicResource IconButton}" Width="36"
                            Click="MinimizeButton_Click">
                        <TextBlock Text="—" FontSize="11" Foreground="{DynamicResource ForegroundDimBrush}"/>
                    </Button>
                    <Button Style="{DynamicResource IconButton}" Width="36"
                            Click="MaximizeButton_Click">
                        <TextBlock Text="□" FontSize="11" Foreground="{DynamicResource ForegroundDimBrush}"/>
                    </Button>
                    <Button Style="{DynamicResource IconButton}" Width="36"
                            Click="CloseButton_Click">
                        <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource ForegroundDimBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BorderBrush}"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="140" MaxWidth="400"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="FileManagerToolbar"
                            Grid.Row="0"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="6,6">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{DynamicResource IconButton}"
                                    ToolTip="{DynamicResource MainTooltipNewNote}"
                                    Click="NewNote_Click">
                                <TextBlock Text="📝" FontSize="12"/>
                            </Button>
                            <Button Style="{DynamicResource IconButton}"
                                    ToolTip="{DynamicResource MainTooltipNewFolder}"
                                    Click="NewFolder_Click">
                                <TextBlock Text="📁" FontSize="12"/>
                            </Button>
                            <Button Style="{DynamicResource IconButton}"
                                    ToolTip="{DynamicResource MainTooltipRename}"
                                    Click="Rename_Click">
                                <TextBlock Text="✏" FontSize="12" Foreground="{DynamicResource ForegroundSubtleBrush}"/>
                            </Button>
                            <Button Style="{DynamicResource IconButton}"
                                    ToolTip="{DynamicResource MainTooltipDelete}"
                                    Click="Delete_Click">
                                <TextBlock Text="🗑" FontSize="12" Foreground="{DynamicResource ForegroundSubtleBrush}"/>
                            </Button>
                            <Button Style="{DynamicResource IconButton}"
                                    ToolTip="{DynamicResource MainTooltipCollapseAll}"
                                    Click="CollapseAll_Click">
                                <TextBlock Text="⊟" FontSize="12" Foreground="{DynamicResource ForegroundSubtleBrush}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <controls1:FileManager x:Name="MyFileManager"
                                          Grid.Row="1"
                                          ItemSelected="MyFileManager_ItemSelected"
                                          ItemMoved="MyFileManager_ItemMoved"/>

                    <controls1:SearchPanel x:Name="MySearchPanel"
                                          Grid.Row="1"
                                          Visibility="Collapsed"
                                          ItemSelected="MySearchPanel_ItemSelected"/>

                    <TextBox x:Name="RenameBox"
                             Grid.Row="2"
                             Visibility="Collapsed"
                             Background="{DynamicResource SurfaceElevatedBrush}"
                             Foreground="{DynamicResource ForegroundSecondaryBrush}"
                             BorderBrush="{DynamicResource AccentBrush}"
                             BorderThickness="1"
                             CaretBrush="{DynamicResource ForegroundSecondaryBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             FontFamily="Segoe UI"
                             FontSize="12.5"
                             Padding="6,5"
                             Margin="4,4"
                             KeyDown="RenameBox_KeyDown"
                             LostFocus="RenameBox_LostFocus"/>
                </Grid>

                <GridSplitter Grid.Column="1"
                              Width="1"
                              Background="{DynamicResource BorderBrush}"
                              ResizeBehavior="PreviousAndNext"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Center"
                              Cursor="SizeWE"/>

                <Grid Grid.Column="2" Background="{DynamicResource WindowBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="{DynamicResource WindowBackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Grid Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="NoteCreateTime"
                                       Grid.Row="0"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       ToolTip="{DynamicResource MainCreateTime}"
                                       Margin="10,2"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="NoteEditTime"
                                       Grid.Row="1"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       ToolTip="{DynamicResource MainEditTime}"
                                       Margin="10,2"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="PageTitle"
                                                   Text="{DynamicResource MainNewTab}"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Cursor="IBeam"
                                                   MouseLeftButtonDown="PageTitle_MouseLeftButtonDown"/>
                                <TextBox x:Name="PageTitleEdit"
                                         Visibility="Collapsed"
                                         Background="Transparent"
                                         Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                         CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                                         SelectionBrush="{DynamicResource AccentBrush}"
                                         BorderThickness="0,0,0,1"
                                         BorderBrush="{DynamicResource AccentBrush}"
                                         FontFamily="Segoe UI"
                                         FontSize="18"
                                         FontWeight="SemiBold"
                                         HorizontalAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         MinWidth="200"
                                         Padding="4,0"
                                         KeyDown="PageTitleEdit_KeyDown"
                                         LostFocus="PageTitleEdit_LostFocus"/>
                            </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,10,0">
                            <Button x:Name="CategoryBtn"
                                    Style="{DynamicResource EditSaveButton}"
                                    Content="{DynamicResource MainBtnCategory}"
                                    Visibility="Collapsed"
                                    Margin="0,0,6,0"
                                    Click="Category_Click"/>
                            <Button x:Name="EditSaveBtn"
                                    Style="{DynamicResource EditSaveButton}"
                                    Content="{DynamicResource MainBtnEdit}"
                                    Visibility="Collapsed"
                                    Click="EditSave_Click"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                               Fill="{DynamicResource BorderSubtleBrush}"/>

                    <Grid Grid.Row="1">

                        <StackPanel x:Name="EmptyState"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="Visible">
                            <TextBlock Text="notes"
                                       Foreground="{DynamicResource ForegroundPhantomBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="72"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,32"/>
                            <Button Style="{DynamicResource NewTabActionButton}"
                                    Content="{DynamicResource MainEmptyCreateFile}"
                                    Margin="0,0,0,8"
                                    Click="NewNote_Click"/>
                            <Button Style="{DynamicResource NewTabActionButton}"
                                    Content="{DynamicResource MainEmptyCreateFolder}"
                                    Click="NewFolder_Click"/>
                        </StackPanel>

                        <TextBox x:Name="NoteEditor"
                                 Visibility="Collapsed"
                                 IsReadOnly="True"
                                 Background="{DynamicResource WindowBackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                 CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="13.5"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Padding="40,24"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"/>

                        <ContentControl x:Name="UserMenuControl"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"/>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="notes"
                           Foreground="{DynamicResource ForegroundGhostBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="8,0"/>
            </Border>

        </Grid>
    </Border>
</Window>
