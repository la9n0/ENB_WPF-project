<Window x:Class="ENB_project.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ENB — Admin"
        Height="600" Width="800"
        MinHeight="400" MinWidth="600"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundDimBrush}"/>
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderMutedBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundMutedBrush}"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ForegroundGhostBrush}"/>
                                <Setter Property="Foreground"  Value="{DynamicResource ForegroundPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
    </Window.Effect>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="{DynamicResource WindowBackgroundBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <TextBlock Text="ENB"
                               Foreground="{DynamicResource ForegroundPhantomBrush}"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" · Admin"
                               Foreground="{DynamicResource ForegroundGhostBrush}"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Style="{DynamicResource IconButton}" Width="36"
                            Click="MinimizeButton_Click">
                        <TextBlock Text="—" FontSize="11" Foreground="{DynamicResource ForegroundDimBrush}"/>
                    </Button>
                    <Button Style="{DynamicResource IconButton}" Width="36"
                            Click="MaximizeButton_Click">
                        <TextBlock Text="□" FontSize="11" Foreground="{DynamicResource ForegroundDimBrush}"/>
                    </Button>
                    <Button Style="{DynamicResource IconButton}" Width="36"
                            Click="CloseButton_Click">
                        <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource ForegroundDimBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                       Fill="{DynamicResource BorderBrush}"/>

            <Grid Grid.Row="1" Margin="20,16,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource AdminTitle}"
                               Foreground="{DynamicResource ForegroundDimBrush}"
                               FontFamily="Segoe UI"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="UserCountText"
                               Foreground="{DynamicResource ForegroundGhostBrush}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{DynamicResource ActionButton}"
                        Content="{DynamicResource AdminRefresh}"
                        VerticalAlignment="Center"
                        Click="Refresh_Click"/>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Bottom"
                       Margin="20,0"
                       Fill="{DynamicResource BorderSubtleBrush}"/>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,12,20,8">
                <StackPanel>

                    <Grid Margin="4,0,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource AdminColLogin}"
                                   Foreground="{DynamicResource ForegroundGhostBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource AdminColEmail}"
                                   Foreground="{DynamicResource ForegroundGhostBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2"
                                   Text="{DynamicResource AdminColNotes}"
                                   Foreground="{DynamicResource ForegroundGhostBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3"
                                   Text="{DynamicResource AdminColActions}"
                                   Foreground="{DynamicResource ForegroundGhostBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <ItemsControl x:Name="UserList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="RowBorder"
                                        Background="{DynamicResource SidebarBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Border x:Name="BlockedBadge"
                                                    Background="#3D1A1A"
                                                    BorderBrush="#7C2D2D"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="5,1"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding BlockedBadgeVisibility}">
                                                <TextBlock Text="blocked"
                                                           Foreground="#E06C75"
                                                           FontFamily="Segoe UI"
                                                           FontSize="10"/>
                                            </Border>
                                            <TextBlock x:Name="LoginText"
                                                       Text="{Binding Login}"
                                                       Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Email}"
                                                   Foreground="{DynamicResource ForegroundGhostBrush}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding NoteCount}"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button Style="{DynamicResource ActionButton}"
                                                    Content="{Binding BlockButtonText}"
                                                    Margin="0,0,6,0"
                                                    Tag="{Binding}"
                                                    Click="Block_Click"/>
                                            <Button Style="{DynamicResource ActionButton}"
                                                    Content="{DynamicResource AdminDelete}"
                                                    Foreground="#E06C75"
                                                    BorderBrush="#7C2D2D"
                                                    Tag="{Binding}"
                                                    Click="Delete_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                        <Setter TargetName="LoginText"  Property="Foreground"
                                                Value="{DynamicResource ForegroundGhostBrush}"/>
                                        <Setter TargetName="RowBorder"  Property="BorderBrush"
                                                Value="#3D1A1A"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyText"
                               Text="{DynamicResource AdminEmpty}"
                               Foreground="{DynamicResource ForegroundGhostBrush}"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="DeleteConfirmPanel"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DeleteConfirmText"
                               Grid.Column="0"
                               Foreground="{DynamicResource ForegroundDimBrush}"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="12,0,0,0">
                        <Button Style="{DynamicResource ActionButton}"
                                Content="{DynamicResource AdminDeleteNo}"
                                Margin="0,0,6,0"
                                Click="DeleteConfirmNo_Click"/>
                        <Button Style="{DynamicResource ActionButton}"
                                Content="{DynamicResource AdminDeleteYes}"
                                Foreground="#E06C75"
                                BorderBrush="#7C2D2D"
                                Click="DeleteConfirmYes_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock Text="ENB Admin"
                           Foreground="{DynamicResource ForegroundGhostBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="8,0"/>
            </Border>
        </Grid>
    </Border>
</Window>
