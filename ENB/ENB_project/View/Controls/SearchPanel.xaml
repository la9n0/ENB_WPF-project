<UserControl x:Class="ENB_project.Controls.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ENB_project.Controls"
             x:Name="Root"
             Background="{DynamicResource SidebarBackgroundBrush}">

    <UserControl.Resources>

        <Style x:Key="SlimThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width"      Value="6"/>
            <Setter Property="MinWidth"   Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Height="0"
                                                  Command="ScrollBar.LineUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource SlimThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Height="0"
                                                  Command="ScrollBar.LineDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="True"/>
                            <ScrollBar Grid.Column="1"
                                       Style="{DynamicResource SlimScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResultRowTemplate" DataType="{x:Type local:SearchResultItem}">
            <Border x:Name="RowBorder"
                    Background="Transparent"
                    CornerRadius="4"
                    Margin="0,1,4,1"
                    MinHeight="40"
                    Cursor="Hand"
                    ClipToBounds="True"
                    MouseLeftButtonDown="ResultRow_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle x:Name="CategoryStripe"
                               Grid.Column="0"
                               Width="3"
                               Fill="Transparent"
                               RadiusX="1.5" RadiusY="1.5"
                               Visibility="{Binding CategoryVisibility}"/>

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NameText"
                                       Text="{Binding Name}"
                                       FontFamily="Segoe UI"
                                       FontSize="12.5"
                                       Padding="10,6"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ReminderBell"
                                       Text=" 🔔"
                                       FontSize="11"
                                       Padding="10,6"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ReminderVisibility}"/>
                        </StackPanel>
                        <TextBlock x:Name="SnippetText"
                                   Text="{Binding Snippet}"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="{DynamicResource ForegroundGhostBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding SnippetVisibility}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                    <Setter TargetName="NameText"  Property="Foreground" Value="{DynamicResource ForegroundPrimaryBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding CategoryVisibility}" Value="Visible">
                    <Setter TargetName="CategoryStripe" Property="Fill"
                            Value="{Binding CategoryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasActiveReminder}" Value="True">
                    <Setter TargetName="RowBorder" Property="BorderBrush"     Value="#E5C07B"/>
                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="6,6">
            <Grid>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMutedBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             Foreground="{DynamicResource ForegroundPrimaryBrush}"
                             CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             BorderThickness="0"
                             FontFamily="Segoe UI"
                             FontSize="12.5"
                             Padding="8,5"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"/>
                </Border>
                <TextBlock x:Name="PlaceholderText"
                           Text="Поиск заметок..."
                           Foreground="{DynamicResource ForegroundDeepBrush}"
                           FontFamily="Segoe UI"
                           FontSize="12.5"
                           Padding="16,5"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="10,6,6,4"
                Visibility="{Binding QueryInfoVisibility, ElementName=Root}">
            <TextBlock Text="{Binding QueryInfo, ElementName=Root}"
                       Foreground="{DynamicResource ForegroundDeepBrush}"
                       FontFamily="Segoe UI"
                       FontSize="11"/>
        </Border>

        <ScrollViewer Grid.Row="2"
                      Style="{DynamicResource SlimScrollViewer}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="4,4,0,6">
            <ItemsControl x:Name="ResultsList"
                          ItemTemplate="{DynamicResource ResultRowTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>