<Window x:Class="ENB_project.CategoryPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Категория" Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
    </Window.Effect>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <StackPanel Margin="16">

            <TextBlock Text="{DynamicResource CategoryPickerTitle}"
                       Foreground="{DynamicResource ForegroundDimBrush}"
                       FontFamily="Segoe UI"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <Border Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    MaxHeight="220"
                    Margin="0,0,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="NoneRow"
                                Background="Transparent"
                                Padding="10,7"
                                Cursor="Hand"
                                MouseLeftButtonDown="NoneRow_Click">
                            <TextBlock x:Name="NoneText"
                                       Text="{DynamicResource CategoryPickerNone}"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="12.5"/>
                        </Border>

                        <ItemsControl x:Name="CatList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="CatRow"
                                            Background="Transparent"
                                            Padding="6,5"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="CatRow_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Rectangle Grid.Column="0"
                                                       Fill="{Binding ColorBrush}"
                                                       RadiusX="2" RadiusY="2"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Name}"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="12.5"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="3"
                                                    Content="✏"
                                                    FontSize="11"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource ForegroundGhostBrush}"
                                                    Cursor="Hand"
                                                    Margin="4,0,0,0"
                                                    Tag="{Binding}"
                                                    Click="EditCat_Click"/>

                                            <Button Grid.Column="4"
                                                    Content="✕"
                                                    FontSize="11"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource ForegroundGhostBrush}"
                                                    Cursor="Hand"
                                                    Margin="2,0,0,0"
                                                    Tag="{Binding}"
                                                    Click="DeleteCat_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="EditorPanel"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{DynamicResource CategoryPickerName}"
                               Foreground="{DynamicResource ForegroundGhostBrush}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderMutedBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Margin="0,0,0,8">
                        <TextBox x:Name="CatNameBox"
                                 Background="Transparent"
                                 Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                 CaretBrush="{DynamicResource ForegroundPrimaryBrush}"
                                 BorderThickness="0"
                                 FontFamily="Segoe UI" FontSize="12.5"
                                 Padding="8,5"/>
                    </Border>

                    <TextBlock Text="{DynamicResource CategoryPickerColor}"
                               Foreground="{DynamicResource ForegroundGhostBrush}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Margin="0,0,0,6"/>

                    <WrapPanel x:Name="ColorPicker" Margin="0,0,0,8">
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="{DynamicResource CategoryPickerCancel}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderMutedBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource ForegroundMutedBrush}"
                                FontFamily="Segoe UI" FontSize="12"
                                Height="28" Cursor="Hand"
                                Click="EditorCancel_Click"/>

                        <Border Grid.Column="2"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="4" Cursor="Hand">
                            <Button Content="{DynamicResource CategoryPickerSave}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="White"
                                    FontFamily="Segoe UI" FontSize="12"
                                    Height="28" Cursor="Hand"
                                    Click="EditorSave_Click"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            
            <Button x:Name="AddCatBtn"
                    Content="{DynamicResource CategoryPickerAdd}"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource AccentBrush}"
                    FontFamily="Segoe UI" FontSize="12"
                    HorizontalAlignment="Left"
                    Cursor="Hand"
                    Margin="0,0,0,10"
                    Click="AddCat_Click"/>
            
            <Button Content="{DynamicResource CategoryPickerClose}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderMutedBrush}"
                    BorderThickness="1"
                    Foreground="{DynamicResource ForegroundMutedBrush}"
                    FontFamily="Segoe UI" FontSize="12"
                    Height="30" Cursor="Hand"
                    Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>