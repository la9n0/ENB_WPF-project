<UserControl x:Class="ENB_project.Controls.UserMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ENB_project.Controls"
             x:Name="Root">

    <UserControl.Resources>

        <Style x:Key="DropComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                                <TextBlock x:Name="Arrow"
                                           Grid.Column="1"
                                           Text="›"
                                           FontSize="14"
                                           Foreground="{DynamicResource ForegroundGhostBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="ArrowRotate" Angle="90"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background"  Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ForegroundGhostBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background"  Value="{DynamicResource AccentDeepBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="270" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="90" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="DropComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton Style="{StaticResource DropComboBoxToggleButton}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}"
                              Height="{TemplateBinding Height}">
                    <TextBlock Text="{TemplateBinding Text}"
                               Foreground="{DynamicResource ForegroundPrimaryBrush}"
                               FontFamily="Segoe UI"
                               FontSize="12.5"
                               VerticalAlignment="Center"/>
                </ToggleButton>
                <Popup IsOpen="{Binding IsDropDownOpen,
                               RelativeSource={RelativeSource TemplatedParent}}"
                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Bottom"
                       StaysOpen="False"
                       MinWidth="{Binding ActualWidth,
                                  RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,2,0,0">
                        <ItemsPresenter/>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="DropComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground"  Value="{DynamicResource ForegroundMutedBrush}"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Padding"     Value="10,6"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="12.5"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource SurfaceHighBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ForegroundPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource AccentDeepBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DropComboBox" TargetType="ComboBox">
            <Setter Property="Template"           Value="{StaticResource DropComboBoxTemplate}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DropComboBoxItemStyle}"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="IsEditable"         Value="False"/>
        </Style>

        <Style x:Key="FieldEditButton" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource BorderMutedBrush}"/>
            <Setter Property="Foreground"        Value="{DynamicResource ForegroundSubtleBrush}"/>
            <Setter Property="FontFamily"        Value="Segoe UI"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="Height"            Value="22"/>
            <Setter Property="Padding"           Value="8,0"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="{DynamicResource AccentSurfaceBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"  Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundGhostBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SidebarBackgroundBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource SidebarBackgroundBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundPrimaryBrush}"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource ForegroundPrimaryBrush}"/>
            <Setter Property="SelectionBrush"  Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderMutedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background"      Value="{DynamicResource SidebarBackgroundBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundPrimaryBrush}"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource ForegroundPrimaryBrush}"/>
            <Setter Property="SelectionBrush"  Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderMutedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogActionButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderMutedBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ForegroundMutedBrush}"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="{DynamicResource AccentSurfaceBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"  Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                    Padding="24,16">
                <TextBlock Text="{DynamicResource UserMenuTitle}"
                           Foreground="{DynamicResource ForegroundDimBrush}"
                           FontFamily="Segoe UI"
                           FontSize="18"
                           FontWeight="SemiBold"/>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,20,24,24">
                <StackPanel>

                    <Border Style="{DynamicResource SectionBorder}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource FieldLabel}"
                                       Text="{DynamicResource UserMenuLogin}"/>
                            <TextBox x:Name="LoginBox"
                                     Style="{DynamicResource FieldTextBox}"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource SectionBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{DynamicResource FieldLabel}"
                                           Text="{DynamicResource UserMenuPassword}"
                                           VerticalAlignment="Center"
                                           Margin="0"/>
                                <Button Grid.Column="1"
                                        x:Name="PasswordEditBtn"
                                        Style="{DynamicResource FieldEditButton}"
                                        Content="{DynamicResource UserMenuEdit}"
                                        Click="PasswordEdit_Click"/>
                            </Grid>

                            <TextBox x:Name="PasswordMaskBox"
                                     Style="{DynamicResource FieldTextBox}"
                                     IsReadOnly="True"
                                     Text="••••••••"/>

                            <Border x:Name="PasswordDialog"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource WindowBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource UserMenuCurrentPassword}"
                                               Style="{DynamicResource FieldLabel}"
                                               Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="CurrentPasswordBox"
                                                 Style="{DynamicResource FieldPasswordBox}"
                                                 Margin="0,0,0,10"/>

                                    <TextBlock Text="{DynamicResource UserMenuNewPassword}"
                                               Style="{DynamicResource FieldLabel}"
                                               Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="NewPasswordBox"
                                                 Style="{DynamicResource FieldPasswordBox}"
                                                 Margin="0,0,0,4"
                                                 PasswordChanged="NewPasswordSizeControl"/>

                                    <TextBlock x:Name="NewPasswordError"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               Margin="0,0,0,6"
                                               Visibility="Collapsed"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{DynamicResource UserMenuRepeatPassword}"
                                               Style="{DynamicResource FieldLabel}"
                                               Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="RepeatPasswordBox"
                                                 Style="{DynamicResource FieldPasswordBox}"
                                                 Margin="0,0,0,4"
                                                 PasswordChanged="RepeatPasswordSizeControl"/>

                                    <TextBlock x:Name="RepeatPasswordError"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               Margin="0,0,0,6"
                                               Visibility="Collapsed"
                                               TextWrapping="Wrap"/>

                                    <TextBlock x:Name="PasswordDialogError"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               Margin="0,0,0,8"
                                               Visibility="Collapsed"
                                               TextWrapping="Wrap"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Style="{DynamicResource DialogActionButton}"
                                                Content="{DynamicResource UserMenuCancel}"
                                                Click="PasswordDialogCancel_Click"/>
                                        <Button Grid.Column="2"
                                                Style="{DynamicResource DialogActionButton}"
                                                Content="{DynamicResource UserMenuConfirm}"
                                                Click="PasswordDialogConfirm_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource SectionBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{DynamicResource FieldLabel}"
                                           Text="{DynamicResource UserMenuEmail}"
                                           VerticalAlignment="Center"
                                           Margin="0"/>
                                <Button Grid.Column="1"
                                        x:Name="EmailEditBtn"
                                        Style="{DynamicResource FieldEditButton}"
                                        Content="{DynamicResource UserMenuEdit}"
                                        Tag="Email"
                                        Click="FieldEdit_Click"/>
                            </Grid>
                            <TextBox x:Name="EmailBox"
                                     Style="{DynamicResource FieldTextBox}"
                                     IsReadOnly="True"
                                     PreviewTextInput="OnlyText"
                                     LostFocus="EmailCheck"/>
                            <TextBlock x:Name="EmailError"
                                       Text="{DynamicResource UserMenuEmailError}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       Visibility="Hidden"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource SectionBorder}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource FieldLabel}"
                                       Text="{DynamicResource UserMenuTheme}"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="ThemeDropList"
                                      Style="{StaticResource DropComboBox}"
                                      HorizontalAlignment="Left"
                                      Width="180"
                                      Height="30"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource SectionBorder}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource FieldLabel}"
                                       Text="{DynamicResource UserMenuLanguage}"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="LanguageDropList"
                                      Style="{StaticResource DropComboBox}"
                                      HorizontalAlignment="Left"
                                      Width="180"
                                      Height="30"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>