<UserControl x:Class="ENB_project.Controls.FileManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ENB_project.Controls"
             x:Name="Root"
             Background="{DynamicResource SidebarBackgroundBrush}"
             AllowDrop="True"
             Drop="Control_Drop">

    <UserControl.Resources>

        <Style x:Key="SlimThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width"      Value="6"/>
            <Setter Property="MinWidth"   Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Height="0" Command="ScrollBar.LineUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource SlimThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Height="0" Command="ScrollBar.LineDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="True"/>
                            <ScrollBar Grid.Column="1"
                                       Style="{DynamicResource SlimScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FlatRowTemplate" DataType="{x:Type local:FileManagerFlatItem}">
            <Border x:Name="RowBorder"
                    Background="Transparent"
                    CornerRadius="4"
                    Margin="0,1,4,1"
                    MinHeight="26"
                    Cursor="Hand"
                    AllowDrop="True"
                    MouseLeftButtonDown="Row_MouseLeftButtonDown"
                    MouseMove="Row_MouseMove"
                    DragOver="Row_DragOver"
                    DragLeave="Row_DragLeave"
                    Drop="Row_Drop"
                    ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="{Binding IndentWidth}"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle x:Name="CategoryStripe"
                               Grid.Column="0"
                               Width="3"
                               Fill="Transparent"
                               RadiusX="1.5" RadiusY="1.5"/>

                    <Rectangle Grid.Column="1" Fill="Transparent"/>

                    <TextBlock Grid.Column="2"
                               x:Name="Arrow"
                               Text="›"
                               FontSize="13"
                               Foreground="{DynamicResource ForegroundGhostBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <TextBlock Grid.Column="3"
                               x:Name="NameText"
                               Text="{Binding Item.Name}"
                               FontFamily="Segoe UI"
                               FontSize="12.5"
                               Foreground="{DynamicResource ForegroundMutedBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Padding="3,0,0,0"/>

                    <TextBlock x:Name="ReminderBell"
                               Grid.Column="4"
                               Text="🔔"
                               FontSize="9"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,0,4,0"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Item.IsFolder}" Value="True">
                    <Setter TargetName="Arrow"    Property="Visibility" Value="Visible"/>
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}"/>
                    <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Item.IsExpanded}" Value="True">
                    <Setter TargetName="Arrow" Property="Text"       Value="⌄"/>
                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource ForegroundDimBrush}"/>
                    <Setter TargetName="Arrow" Property="FontSize"   Value="11"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Item.IsSelected}" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SurfaceHighBrush}"/>
                    <Setter TargetName="NameText"  Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Item.IsDragOver}" Value="True">
                    <Setter TargetName="RowBorder" Property="Background"      Value="{DynamicResource DragHighlightBrush}"/>
                    <Setter TargetName="RowBorder" Property="BorderBrush"     Value="{DynamicResource DragHighlightBorderBrush}"/>
                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="1"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Item.HasCategory}" Value="True">
                    <Setter TargetName="CategoryStripe" Property="Fill"
                            Value="{Binding Item.CategoryBrush}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Item.HasActiveReminder}" Value="True">
                    <Setter TargetName="ReminderBell" Property="Visibility"   Value="Visible"/>
                    <Setter TargetName="RowBorder"    Property="BorderBrush"  Value="#E5C07B"/>
                    <Setter TargetName="RowBorder"    Property="BorderThickness" Value="1"/>
                </DataTrigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource SlimScrollViewer}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="4,6,0,6">
        <ItemsControl x:Name="PartList"
                      ItemsSource="{Binding FlatItems, ElementName=Root}"
                      ItemTemplate="{DynamicResource FlatRowTemplate}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </ScrollViewer>
</UserControl>